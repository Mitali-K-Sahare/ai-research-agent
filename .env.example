# =============================================================
# Project 3: AI Research Agent — Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual keys:
#   cp .env.example .env
# =============================================================

# --- LLM API Key (pick ONE) ---
OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# --- LangSmith Tracing (optional but recommended) ---
# Sign up free at: https://smith.langchain.com
# Create an API key → paste it below → every agent run gets traced automatically
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_your_langsmith_key_here
LANGSMITH_PROJECT=research-agent
